* Original reference-inspired Buck/Boost model. Not manufacturer silicon.
.subckt GNISO_PMOS D G S params: RON=.05 COSS=200p CG=1n VG=10 CJ=20p
Smain S D S G PSW
.model PSW SW(Ron={RON} Roff=1e9 Vt={VG/2} Vh=0.01)
Coss D S {COSS}
Cgate G S {CG}
Xbody D S GPWR_DIODE VF=.8 CJ={CJ}
.ends GNISO_PMOS
.subckt GNISO_CORE COMP CS EN VCC GATE RAMP ILIM COM params: FSW=250e3 MODE=1 DMAX=0.7 VM=1 A_CS=1 SLOPE=0 TBLANK=100e-9 TONMIN=100e-9 TPROP=20e-9 VG=10 RDRV=2 UVLO=4.5 COFF=0 LIMIT_RAMP=0
Vclock clock COM PULSE(0 1 0 1e-9 1e-9 {min(20e-9,0.01/FSW)} {1/FSW})
Vage age COM PULSE(0 {1/FSW} 0 {1/FSW-1e-12} 1e-12 0 {1/FSW})
Bon active COM V=if((V(EN,COM)>0.5)&(V(VCC,COM)>{UVLO}),1,0)
Bramp RAMP COM V=if({MODE}>0.5,{A_CS}*V(CS,COM)+{SLOPE}*V(age,COM),{VM}*{FSW}*V(age,COM))
Breset reset COM V=if((V(active,COM)<0.5)|(V(age,COM)>={DMAX/FSW})|((V(age,COM)>={TBLANK})&((V(CS,COM)+{LIMIT_RAMP*SLOPE}*V(age,COM))>=V(ILIM,COM)))|((V(age,COM)>={max(TBLANK,TONMIN)})&(V(RAMP,COM)>=max(0,V(COMP,COM)-{COFF}))),1,0)
Bset set COM V=if((V(clock,COM)>0.5)&(V(active,COM)>0.5)&(V(reset,COM)<0.5)&(V(COMP,COM)>{COFF}),1,0)
Alatch set reset COM COM COM COM q COM SRFLOP Vhigh=1 Vlow=0 Td={TPROP} Trise=5e-9 Tfall=5e-9
Bdrive drive COM V=if(V(active,COM)>0.5,{VG}*V(q,COM),0)
Rdriver drive GATE {RDRV}
Rgate GATE COM 1e9
.ends GNISO_CORE

.subckt GNISO_CTRL_FAST FB CS EN VCC GATE COMP RAMP SS FAULT COM params: FSW=250e3 MODE=1 DMAX=0.7 VM=1 A_CS=1 SLOPE=0 CS_LIM=1 TBLANK=100e-9 TONMIN=100e-9 TPROP=20e-9 VG=10 RDRV=2 UVLO=4.5 VSET=30 TSS=1e-3 TYPE=2 KP=100 FZ1=100 FP1=30e3 FZ2=1e3 FP2=80e3 CMAX=2 TEN=0 SSMODE=0 SSFRAC=0.05 COFF=0 SSCLO=1.5 SSCHI=3.5 SCMODE=0 SCP=0.3 SCPBLANK=250e-9 OLPEN=0 TOLP=4.8e-3 THOLD=50e-6 TOFF=340e-3 CS_TAU=0 LIMIT_RAMP=0
Rcs CS cs_filtered 1
Ccs cs_filtered COM {CS_TAU}
Benabled enabled COM V=if((V(EN,COM)>.5)&(V(VCC,COM)>{UVLO}),1,0)
Bready ready COM V=if({TEN}<=0,1,limit(idt(1/{max(TEN,1e-9)},0,V(enabled,COM)<.5),0,1))
Bactive active COM V=if((V(enabled,COM)>.5)&(V(ready,COM)>.999),1,0)
Bss SS COM V=limit(idt(if(V(active,COM)>.5,1/{TSS},0),0,V(active,COM)<.5),0,1)
Blim ilim COM V={CS_LIM}*if({SSMODE}==1,{SSFRAC}+(1-{SSFRAC})*V(SS,COM),1)
Bfault FAULT COM V=0
Berror error COM V={VSET}*if({SSMODE}==0,V(SS,COM),1)-V(FB,COM)
Xcomp error active command COM GCOMP TYPE={TYPE} KP={KP} FZ1={FZ1} FP1={FP1} FZ2={FZ2} FP2={FP2} CMAX={CMAX}
Bcomp COMP COM V={COFF}+min(V(command,COM),if(({SSMODE}==2)&(V(SS,COM)<0.99999),max(0,{SSCLO}+({SSCHI}-{SSCLO})*V(SS,COM)-{COFF}),{CMAX}))
Xcore COMP cs_filtered active VCC GATE RAMP ilim COM GNISO_CORE FSW={FSW} MODE={MODE} DMAX={DMAX} VM={VM} A_CS={A_CS} SLOPE={SLOPE} TBLANK={TBLANK} TONMIN={TONMIN} TPROP={TPROP} VG={VG} RDRV={RDRV} UVLO={UVLO} COFF={COFF} LIMIT_RAMP={LIMIT_RAMP}
.ends GNISO_CTRL_FAST

.subckt GNISO_CTRL_FULL FB CS EN VCC GATE COMP RAMP SS FAULT COM params: FSW=250e3 MODE=1 DMAX=0.7 VM=1 A_CS=1 SLOPE=0 CS_LIM=1 TBLANK=100e-9 TONMIN=100e-9 TPROP=20e-9 VG=10 RDRV=2 UVLO=4.5 VSET=30 TSS=1e-3 TYPE=2 KP=100 FZ1=100 FP1=30e3 FZ2=1e3 FP2=80e3 CMAX=2 TEN=0 SSMODE=0 SSFRAC=0.05 COFF=0 SSCLO=1.5 SSCHI=3.5 SCMODE=0 SCP=0.3 SCPBLANK=250e-9 OLPEN=0 TOLP=4.8e-3 THOLD=50e-6 TOFF=340e-3 CS_TAU=0 LIMIT_RAMP=0
Rcs CS cs_filtered 1
Ccs cs_filtered COM {CS_TAU}
Xsuper cs_filtered GATE EN VCC active SS ilim FAULT olpt COM GPROTECT FSW={FSW} VG={VG} UVLO={UVLO} TEN={TEN} TSS={TSS} SSMODE={SSMODE} SSFRAC={SSFRAC} CS_LIM={CS_LIM} SCMODE={SCMODE} SCP={SCP} SCPBLANK={SCPBLANK} OLPEN={OLPEN} TOLP={TOLP} THOLD={THOLD} TOFF={TOFF} TBLANK={TBLANK}
Berror error COM V={VSET}*if({SSMODE}==0,V(SS,COM),1)-V(FB,COM)
Xcomp error active command COM GCOMP TYPE={TYPE} KP={KP} FZ1={FZ1} FP1={FP1} FZ2={FZ2} FP2={FP2} CMAX={CMAX}
Bcomp COMP COM V={COFF}+min(V(command,COM),if(({SSMODE}==2)&(V(SS,COM)<0.99999),max(0,{SSCLO}+({SSCHI}-{SSCLO})*V(SS,COM)-{COFF}),{CMAX}))
Xcore COMP cs_filtered active VCC GATE RAMP ilim COM GNISO_CORE FSW={FSW} MODE={MODE} DMAX={DMAX} VM={VM} A_CS={A_CS} SLOPE={SLOPE} TBLANK={TBLANK} TONMIN={TONMIN} TPROP={TPROP} VG={VG} RDRV={RDRV} UVLO={UVLO} COFF={COFF} LIMIT_RAMP={LIMIT_RAMP}
.ends GNISO_CTRL_FULL

.subckt GNISO_NMOS D G S params: RON=0.05 COSS=200e-12 CG=1e-9 VG=10 CJ=20e-12
Smain D S G S MSW
.model MSW SW(Ron={RON} Roff=1e9 Vt={VG/2} Vh=0.01)
Coss D S {COSS}
Cgate G S {CG}
Xbody S D GPWR_DIODE VF=0.8 CJ={CJ}
.ends GNISO_NMOS
